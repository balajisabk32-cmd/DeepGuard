# Byte-compiled / optimized / DLL files
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
.venv/
ENV/
env/
deepfake_env/

# IDE & OS
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# Project specifics
ffmpeg/

# Data & Sessions (gitignored except .gitkeep)
# Corpus media is NEVER committed: it contains teammates' faces and derived
# heart-rate waveforms — biometric/health-adjacent personal data (plan §8.4).
data/corpus/*
!data/corpus/.gitkeep
!data/corpus/MANIFEST.csv
data/sessions/*
!data/sessions/.gitkeep

# Models — ignore ALL weights.
# This rule was previously commented out. H0-E downloads Wav2Lip checkpoints and
# face-swap models (hundreds of MB); GitHub hard-rejects any blob over 100 MB, so
# the first push after H0-E would have failed mid-Hour-0. Weights are vendored into
# the Docker image via COPY, never through git.
models/*
!models/.gitkeep

# Locked dependency set IS committed — it is the reproducibility contract.
!requirements.lock.txt

# Testing & Logs
.pytest_cache/
.ruff_cache/
*.log
results/*
!results/.gitkeep

# Third-party sample media at repo root (licence-unclear, not ours to redistribute)
*.mp4
*.mov
*.mkv
*.webm

# Wav2Lip model weights. lipsync_expert.pth ~50MB, wav2lip_gan.pth ~400MB;
# GitHub hard-rejects blobs over 100MB and the push fails at the worst moment.
Wav2Lip/checkpoints/*
!Wav2Lip/checkpoints/README.md
Wav2Lip/temp/
Wav2Lip/results/

# ── Frontend build & dependencies ─────────────────────────────────────────
# node_modules was NOT ignored while deepguard-x/ was untracked. The moment the
# frontend is committed that becomes a multi-hundred-MB push of vendored deps.
node_modules/
.next/
out/
next-env.d.ts
.vercel/
*.tsbuildinfo

# ── Datasets ──────────────────────────────────────────────────────────────
# Evaluation corpora are large and mostly redistribution-restricted. Never
# commit them; document how to obtain them instead.
DeepfakeTIMIT/
SDFVD*/
TEST_VIDEOS/
data/raw/
feature_1/*.mp4

# ── Scratch / working files ───────────────────────────────────────────────
# Extracted paper text, screenshots and one-off exports. Useful locally,
# noise in the repository.
p*_text.txt
extracted_*.txt
coherence_*.png
*.tar.gz
*.zip

# ── Vendored third-party repos, not part of the build ─────────────────────
# EITLnet lives under a mojibake directory name, ships its own venv/, is not
# imported anywhere in src/, and its licence is unclear. Keep it locally,
# out of our history.
*-d/
Repos/
