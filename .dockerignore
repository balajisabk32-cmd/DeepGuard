# Keep the build context small. Without this, `docker build` ships .git/ and the
# entire video corpus to the daemon on every build — slowest exactly when you are
# iterating fastest.

.git/
.gitignore

# Corpus and session scratch are bind-mounted at runtime, never baked into the image.
data/

# Model weights ARE copied (see Dockerfile) — do not ignore models/.

__pycache__/
*.pyc
*.pyo
.pytest_cache/
.venv/
venv/
env/
ENV/

.idea/
.vscode/
.DS_Store
Thumbs.db

results/
*.log
plan.md
README.md
Makefile
